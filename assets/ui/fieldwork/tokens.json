    "preferredHitArea": 36,
    "inventoryRow": [
      46,
      58
    ],
    "catalogRow": [
      56,
      64
    ]
  },
  "layout": {
    "reference": [
      1280,
      800
    ],
    "compact": {
      "rail": 136,
      "header": 56,
      "contentPadding": 16,
      "footer": 56
    },
    "wideSample": [
      1920,
      1080
    ],
    "desktop": {
      "rail": 164,
      "header": 64,
      "contentPadding": 24,
      "footer": 56
