{
  "meta": {
    "name": "IRON CARAVAN / FIELDWORK",
    "version": "1.0",
    "status": "design proposal",
    "unit": "logical px",
    "fontFilesIncluded": false
  },
  "color": {
    "bg": "#101615",
    "nav": "#131B18",
    "panel": "#19211F",
