  "zIndex": {
    "world": 0,
    "worldPrompt": 10,
    "hud": 20,
    "toast": 30,
    "drawer": 40,
    "scrim": 50,
    "modal": 60,
    "confirmation": 70,
    "activeLayerTooltip": 80
