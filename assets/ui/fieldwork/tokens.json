      "size": 20,
      "lineHeight": 28,
      "weight": 600
    },
    "body": {
      "size": 14,
      "lineHeight": 22,
      "weight": 400
    },
    "secondary": {
      "size": 12,
      "lineHeight": 18,
      "weight": 400
