    "control": 4,
    "panel": 6,
    "badge": 3
  },
  "stroke": {
    "default": 1,
    "focus": 2,
    "icon": 1.6
  },
  "size": {
    "button": 36,
    "buttonCompact": 32,
    "buttonPrimary": 40,
    "buttonHero": 48,
    "icon": 20,
    "iconSmall": 16,
